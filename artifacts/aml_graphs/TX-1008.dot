digraph aml_decision {
  rankdir=LR;
  graph [fontname=Helvetica];
  node [fontname=Helvetica];
  tx [shape=box, style="rounded,filled", fillcolor="#dbeafe", label="Transaction\nTX-1008\n$5,000.00"];
  origin [shape=ellipse, label="Account\nA-900"];
  beneficiary [shape=ellipse, label="Account\nB-910"];
  origin -> tx [label=originates];
  tx -> beneficiary [label=beneficiary];
  fact_0 [shape=note, fillcolor="#fef3c7", style=filled, label="Fact\nExpectedPayrollDay"];
  tx -> fact_0;
  fact_1 [shape=note, fillcolor="#fef3c7", style=filled, label="Fact\nOldKYC"];
  tx -> fact_1;
  fact_2 [shape=note, fillcolor="#fef3c7", style=filled, label="Fact\nRecentlyManuallyVerified"];
  tx -> fact_2;
  evidence_0 [shape=component, fillcolor="#fee2e2", style=filled, label="Evidence\nAML-R06-KYC"];
  fact_1 -> evidence_0;
  evidence_1 [shape=component, fillcolor="#dcfce7", style=filled, label="Evidence\nAML-R09-MANUAL-KYC"];
  fact_2 -> evidence_1;
  evidence_2 [shape=component, fillcolor="#dcfce7", style=filled, label="Evidence\nAML-R10-PAYROLL"];
  fact_0 -> evidence_2;
  decision [shape=doubleoctagon, style="filled,bold", fillcolor="#ddd6fe", label="Decision\nALLOW"];
  evidence_0 -> decision;
  evidence_1 -> decision;
  evidence_2 -> decision;
}
